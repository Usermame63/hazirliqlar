generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  email          String          @unique
  passwordHash   String
  phone          String?
  role           Role            @default(STUDENT)
  avatarUrl      String?
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  
  teacherProfile TeacherProfile?
  sentMessages   Message[]       @relation("SentMessages")
  receivedMsgs   Message[]       @relation("ReceivedMessages")
  reviews        Review[]        @relation("StudentReviews")

  // --- YENİ ƏLAVƏLƏR (Təhsil və Əlaqələr) ---
  educationLevel       String?           
  educationInstitution String?           
  
  // --- DÜZƏLDİLƏN ƏLAQƏLƏR (Prisma üçün hər iki tərəf mütləqdir) ---
  viewedTeachers       ViewedTeacher[]   @relation("StudentViews")
  viewedByStudents     ViewedTeacher[]   @relation("TeacherViewed")
  favorites            Favorite[]        @relation("StudentFavorites")
  favoritedBy          Favorite[]        @relation("TeacherFavorites")
}

model TeacherProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  
  fatherName     String?
  subjects       String[] 
  experience     Int      
  pricePerMonth  Float
  teachingLang   String[]
  mode           String   
  about          String?
  address        String?
  lat            Float?   
  lng            Float?   
  certificates   String[] 
  isActive       Boolean  @default(true)
  isPremium      Boolean  @default(false)
  
  reviews        Review[]
  photoUrl       String?
}

model Review {
  id             String         @id @default(uuid())
  rating         Int            
  comment        String?
  studentId      String
  student        User           @relation("StudentReviews", fields: [studentId], references: [id])
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id])
  createdAt      DateTime       @default(now())
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Feedback {
  id         String          @id @default(uuid())
  text       String
  rating     Int
  authorId   String
  authorName String
  role       String          @default("USER")
  createdAt  DateTime        @default(now())
  replies    FeedbackReply[]
}

model FeedbackReply {
  id         String   @id @default(uuid())
  text       String
  authorId   String
  authorName String
  role       String   @default("USER")
  createdAt  DateTime @default(now())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
}

// --- YENİ MODELLƏR ---
model ViewedTeacher {
  id          String   @id @default(uuid())
  studentId   String
  teacherId   String
  viewedAt    DateTime @default(now())

  student     User     @relation("StudentViews", fields: [studentId], references: [id])
  teacher     User     @relation("TeacherViewed", fields: [teacherId], references: [id])

  @@unique([studentId, teacherId])
}

model Favorite {
  id          String   @id @default(uuid())
  studentId   String
  teacherId   String
  createdAt   DateTime @default(now())

  student     User     @relation("StudentFavorites", fields: [studentId], references: [id])
  teacher     User     @relation("TeacherFavorites", fields: [teacherId], references: [id])

  @@unique([studentId, teacherId])
}